---
import SiteLayout from '../layouts/SiteLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<SiteLayout>
  <main>
    <section class="archive-intro" aria-labelledby="page-title">
      <div class="intro-copy">
        <p class="eyebrow">Study Hub / Biology</p>
        <h1 id="page-title">Biology archive</h1>
        <p class="intro-description">Find curriculum notes, practical guidance, and exam practice for focused revision.</p>
        <a class="text-link" href="#archive">Browse the archive <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="intro-image">
        <img src={`${import.meta.env.BASE_URL}/biology.jpg`} alt="Biology learning and life sciences" />
        <figcaption>Explore living systems, from cells to ecosystems.</figcaption>
      </figure>
    </section>

    <section
      class="archive-section"
      id="archive"
      aria-labelledby="archive-title"
      data-biology-archive
      data-supabase-url={supabaseUrl}
      data-supabase-anon-key={supabaseAnonKey}
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse resources</p>
          <h2 id="archive-title">The collection</h2>
        </div>
        <p>Search by title, topic, level, or year.</p>
      </div>

      <div class="archive-controls">
        <label class="search-field">
          <span>Search archive</span>
          <input id="archive-search" type="search" placeholder="Try genetics or 2024" autocomplete="off" />
        </label>
        <label class="select-field">
          <span>Level</span>
          <select id="level-filter"><option value="">All levels</option></select>
        </label>
        <label class="select-field">
          <span>Sort</span>
          <select id="sort-order">
            <option value="title">Title</option>
            <option value="recent">Recently added</option>
            <option value="year">Year</option>
          </select>
        </label>
      </div>

      <div class="archive-tabs" role="group" aria-label="Filter by resource type">
        <button type="button" data-category="all" aria-pressed="true">All resources</button>
        <button type="button" data-category="notes" aria-pressed="false">Notes</button>
        <button type="button" data-category="papers" aria-pressed="false">Past papers</button>
      </div>

      <p class="archive-status" id="archive-status" role="status" aria-live="polite">Connecting to the shared archive...</p>
      <div class="resource-list" id="resource-list" aria-live="polite"></div>
      <button class="button button-outline load-more" id="load-more" type="button" hidden>Load more</button>
    </section>

    <section class="contribute-band" aria-labelledby="contribute-title">
      <div>
        <p class="eyebrow">Study Hub</p>
        <h2 id="contribute-title">Need another Biology resource?</h2>
        <p>Contact the Study Hub team to request a topic or suggest material for the archive.</p>
      </div>
      <a class="button button-light" href="mailto:trusteth777@gmail.com?subject=Biology%20resource%20request">Request a resource <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</SiteLayout>

<script>
  import '../scripts/archive';
</script>
